{
  "openapi": "3.0.3",
  "info": {
    "title": "Password Manager API",
    "version": "1.1.0",
    "description": "REST API для десктопных клиентов. Аутентификация: Bearer JWT (получить через /auth/login) или API-ключ (X-API-Key, создать через /auth/api-keys после логина)."
  },
  "servers": [{ "url": "/api/v1" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
    },
    "schemas": {
      "Error": { "type": "object", "properties": { "error": { "type": "string" } } },
      "LoginInput": { "type": "object", "required": ["username", "password"], "properties": {
        "username": { "type": "string" }, "password": { "type": "string", "format": "password" } } },
      "LoginResponse": { "type": "object", "properties": {
        "token": { "type": "string" }, "expires_at": { "type": "string", "format": "date-time" },
        "username": { "type": "string" } } },
      "APIKey": { "type": "object", "properties": {
        "id": { "type": "integer", "format": "int64" }, "user_id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" }, "key_prefix": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "last_used_at": { "type": "string", "format": "date-time", "nullable": true } } },
      "APIKeyCreated": { "allOf": [
        { "$ref": "#/components/schemas/APIKey" },
        { "type": "object", "properties": { "key": { "type": "string", "description": "Plaintext key — показан один раз" } } } ] },
      "APIKeyInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } },
      "Group": { "type": "object", "properties": {
        "id": { "type": "integer", "format": "int64" }, "user_id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" }, "password_count": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" } } },
      "GroupInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } },
      "Password": { "type": "object", "properties": {
        "id": { "type": "integer", "format": "int64" }, "user_id": { "type": "integer", "format": "int64" },
        "group_id": { "type": "integer", "format": "int64", "nullable": true },
        "title": { "type": "string" }, "username": { "type": "string" },
        "password": { "type": "string", "description": "Расшифрованный пароль (только в ответе)" },
        "url": { "type": "string" }, "notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" } } },
      "PasswordInput": { "type": "object", "required": ["title", "username", "password"], "properties": {
        "group_id": { "type": "integer", "format": "int64", "nullable": true },
        "title": { "type": "string" }, "username": { "type": "string" },
        "password": { "type": "string" }, "url": { "type": "string" }, "notes": { "type": "string" } } }
    }
  },
  "paths": {
    "/auth/login": {
      "post": { "summary": "Логин", "tags": ["Auth"], "requestBody": { "required": true, "content": {
        "application/json": { "schema": { "$ref": "#/components/schemas/LoginInput" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } } }
    },
    "/auth/api-keys": {
      "get": { "summary": "Список API-ключей", "tags": ["API Keys"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": {
          "type": "array", "items": { "$ref": "#/components/schemas/APIKey" } } } } } } },
      "post": { "summary": "Создать API-ключ (plaintext виден один раз)", "tags": ["API Keys"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/APIKeyInput" } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/APIKeyCreated" } } } } } }
    },
    "/auth/api-keys/{id}": {
      "delete": { "summary": "Отозвать API-ключ", "tags": ["API Keys"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } } }
    },
    "/passwords": {
      "get": { "summary": "Список паролей", "tags": ["Passwords"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [{
          "name": "q",
          "in": "query",
          "required": false,
          "description": "Поиск по title/username/url/notes/group_name (ILIKE, регистронезависимо). Содержимое пароля НЕ ищется — оно зашифровано.",
          "schema": { "type": "string" }
        }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": {
          "type": "array", "items": { "$ref": "#/components/schemas/Password" } } } } } } },
      "post": { "summary": "Создать пароль", "tags": ["Passwords"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/PasswordInput" } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/Password" } } } } } }
    },
    "/passwords/{id}": {
      "get": { "summary": "Получить пароль", "tags": ["Passwords"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK", "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/Password" } } } } } },
      "put": { "summary": "Обновить пароль", "tags": ["Passwords"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/PasswordInput" } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/Password" } } } } } },
      "delete": { "summary": "Удалить пароль", "tags": ["Passwords"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "204": { "description": "Deleted" } } }
    },
    "/groups": {
      "get": { "summary": "Список групп", "tags": ["Groups"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [{
          "name": "q",
          "in": "query",
          "required": false,
          "description": "Поиск по названию группы (ILIKE, регистронезависимо).",
          "schema": { "type": "string" }
        }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": {
          "type": "array", "items": { "$ref": "#/components/schemas/Group" } } } } } } },
      "post": { "summary": "Создать группу", "tags": ["Groups"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/GroupInput" } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/Group" } } } } } }
    },
    "/groups/{id}": {
      "put": { "summary": "Переименовать группу", "tags": ["Groups"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/GroupInput" } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/Group" } } } } } },
      "delete": { "summary": "Удалить группу", "tags": ["Groups"],
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "204": { "description": "Deleted" } } }
    }
  }
}
